# Copia este archivo a `.env` y completa con tus credenciales reales.

# CORS — orígenes permitidos del frontend (separa múltiples con coma)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP para enviar notificaciones del formulario de contacto.
# Si dejas estas variables vacías, el endpoint igual responde 200 y solo loguea
# el payload en consola (útil para desarrollo sin credenciales SMTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password
NOTIFY_EMAIL=renzogutierrez966111@gmail.com
