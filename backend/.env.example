# Copia este archivo a `.env` y completa con tus credenciales reales.

# CORS — orígenes permitidos del frontend (separa múltiples con coma)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Resend — API key para enviar notificaciones del formulario por HTTPS.
# Obtén una gratis en https://resend.com (100 emails/día).
# Si dejas RESEND_API_KEY vacío, el endpoint igual responde 200 y solo loguea
# el payload en consola (útil en desarrollo).
RESEND_API_KEY=
RESEND_FROM=Nexlayer <onboarding@resend.dev>
NOTIFY_EMAIL=renzogutierrez966111@gmail.com
